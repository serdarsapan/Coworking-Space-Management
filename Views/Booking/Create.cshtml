@model webProgramming.Models.Booking
@{ 
    ViewBag.Title = "Reserve Facility";
    var facility = (webProgramming.Models.Facility)ViewBag.Facility;
}

<div class="card shadow-sm mt-4" style="max-width: 600px;">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Reserve @facility.Name</h4>
    </div>
    <div class="card-body p-4">
        <p class="text-muted mb-4">
            <strong>Type:</strong> @facility.Type | <strong>Capacity:</strong> @facility.Capacity Persons
        </p>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.FacilityId)
            
            <!-- Shows our custom validation errors (like double-booking) -->
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.StartTime, "Start Time", new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.StartTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                @Html.ValidationMessageFor(m => m.StartTime, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.EndTime, "End Time", new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.EndTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                @Html.ValidationMessageFor(m => m.EndTime, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Index", "Facility")" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-success">Confirm Reservation</button>
            </div>
        }
    </div>
</div>