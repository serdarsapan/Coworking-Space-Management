@{
    ViewBag.Title = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Contact Us</h2>
<p>Have questions about our spaces or booking system? Send us a message!</p>
<br>

<form id="contactForm">
    <div class="form-group">
        <label for="name">Full Name:</label>
        <input type="text" id="name" placeholder="Enter your full name">
        <div id="nameError" class="error-msg">Please enter your name.</div>
    </div>
    
    <div class="form-group">
        <label for="email">Email Address:</label>
        <input type="email" id="email" placeholder="Enter your email address">
        <div id="emailError" class="error-msg">Please enter a valid email address.</div>
    </div>

    <div class="form-group">
        <label for="message">Message:</label>
        <textarea id="message" rows="5" placeholder="How can we help you?"></textarea>
        <div id="msgError" class="error-msg">Please enter a message.</div>
    </div>

    <button type="submit" class="btn">Send Message</button>
</form>

        @section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const contactForm = document.getElementById('contactForm');
            
            if (contactForm) {
                contactForm.addEventListener('submit', function (e) {
                    e.preventDefault(); // Butona basılınca sayfanın yenilenmesini durdurur
                    
                    let isValid = true;
                    let name = document.getElementById('name').value;
                    let email = document.getElementById('email').value;
                    let message = document.getElementById('message').value;

                    // İsim Kontrolü
                    if (name.trim() === '') {
                        document.getElementById('nameError').style.display = 'block';
                        isValid = false;
                    } else {
                        document.getElementById('nameError').style.display = 'none';
                    }

                    // E-posta Kontrolü (MVC Razor çakışmaması için çift @@ kullanıldı)
                    if (email.trim() === '' || !email.includes('@@')) {
                        document.getElementById('emailError').style.display = 'block';
                        isValid = false;
                    } else {
                        document.getElementById('emailError').style.display = 'none';
                    }

                    // Mesaj Kontrolü
                    if (message.trim() === '') {
                        document.getElementById('msgError').style.display = 'block';
                        isValid = false;
                    } else {
                        document.getElementById('msgError').style.display = 'none';
                    }

                    // Sorun yoksa alert ver ve formu temizle
                    if (isValid) {
                        alert("Thank you, " + name + "! Your message has been sent successfully.");
                        contactForm.reset();
                    }
                });
            }
        });
    </script>
}