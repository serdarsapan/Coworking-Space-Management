@model webProgramming.Models.Notification
@{ ViewBag.Title = "Send Notification"; }

<div class="card shadow-sm mt-4" style="max-width: 600px;">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Broadcast Notification</h4>
    </div>
    <div class="card-body p-4">
        <div class="alert alert-warning mb-4">
            <strong>Note:</strong> This message will be sent to ALL registered users in the system.
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Message, "Notification Message", new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Message, new { @class = "form-control", rows = "5", placeholder = "Type your alert or announcement here..." })
                @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-success">Send Message</button>
            </div>
        }
    </div>
</div>