<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Coworking Space</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Url.Content ile CSS yolunu MVC için %100 garantili hale getirdik -->
    <link rel="stylesheet" href="@Url.Content("~/wwwroot/css/style.css")">
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- DÜZELTME BURADA: Bootstrap 5.3 kurallarına göre data-bs-theme="dark" eklendi -->
    <nav class="navbar navbar-expand-lg bg-dark shadow-sm" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">Coworking Space</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "Home")">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contact", "Home")">Contact Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Facility")">Facilities</a>
                    </li>
                    
                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Calendar", "Booking")">Calendar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Booking")">My Bookings</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Notifications", "Facility")">Notification</a>
                        </li>
                    }
                    
                    @if (Request.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning" href="@Url.Action("Dashboard", "Admin")">Admin Panel</a>
                        </li>
                    }
                </ul>
                
                <ul class="navbar-nav ms-auto">
                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="navbar-text me-3 text-white">Hello, @User.Identity.Name!</span>
                        </li>
                        <li class="nav-item">
                            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm mt-1">Log Out</button>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-light btn-sm mt-1" href="@Url.Action("Login", "Account")">Log In</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm mt-1" href="@Url.Action("Register", "Account")">Sign Up</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- İçerik Alanı -->
    <main class="container my-5 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @RenderBody()
    </main>

    <!-- Footer Alanı -->
    <footer class="bg-dark border-top py-3 mt-auto text-center text-light">
        <div class="container">
            <small class="text-dark">&copy; @DateTime.Now.Year - Coworking Space Management System. All rights reserved.</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Url.Content ile JS yolunu MVC için garantiledik -->
    <script src="@Url.Content("~/wwwroot/js/main.js")"></script>
    
    @RenderSection("scripts", required: false)
</body>
</html>