@model IEnumerable<webProgramming.Models.Notification>
@{ ViewBag.Title = "My Notifications"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Notifications</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        There is no notification for you now.
    </div>
}
else
{
    <div class="row">
        @foreach (var note in Model)
        {
            <div class="col-12 mb-3">
                <div class="card shadow-sm border-start border-warning border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title text-warning mb-1">System's Messages</h5>
                            <small class="text-muted">@note.DateSent.ToString("dd MMM yyyy - HH:mm")</small>
                        </div>
                        <p class="card-text mt-2">@note.Message</p>
                    </div>
                </div>
            </div>
        }
    </div>
}