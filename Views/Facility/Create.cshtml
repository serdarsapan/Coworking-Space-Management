@model webProgramming.Models.Facility
@{ ViewBag.Title = "Add Facility"; }

<div class="card shadow-sm mt-4" style="max-width: 600px;">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Add New Facility</h4>
    </div>
    <div class="card-body p-4">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "e.g., Conference Room A" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Type, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(m => m.Type, new SelectList(new[] { "Office", "Meeting-Room", "Desk" }), "Select Type", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Capacity, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Capacity, new { @class = "form-control", type = "number", min = "1" })
                @Html.ValidationMessageFor(m => m.Capacity, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-success">Save Facility</button>
            </div>
        }
    </div>
</div>